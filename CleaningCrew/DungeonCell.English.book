Language English

Book DungeonCell Ordered No Keep Looped

	Page ExploreViaTorturChamber No Text
		Triggered By @ExploreDungeonCellViaTortureChamber
		exploredCellViaTortureChamber = true
		exploredCell = true
	End Page ExploreViaTorturChamber
	
	Page Place
		
		Prolog """
			When you look through the bars, it's dark inside. You think that you
			hear something.
		"""
		Button "Explore"
		
		Text """
			The cell is no brighter than it was before you opened the door, but
			now you can see the bloodstains. Take 1 facedown Horror ({will} 
			negates), then discard this Explore token.
		"""
		
		Remove TokenExploreCellViaTortureChamber
	End Page Place
	
	Page PlaceHoleInWall
		Visible When readAboutBoy
		Triggered By @ReadAboutBoy When exploredCell
		
		Add TokenCellHoleInWall!
		
		Text """
			A ray of light coming from the middle of a solid wall catches your
			eye. This must be the hole you read about in the journal.
			
			Place a Trapdoor as indicated.
		"""
		
		cellHoleFound = true
	End Page PlaceHoleInWall
	
	Page PlaceExploreAltarViaCell
		Visible When readAboutBoy
	
		Add TokenExploreAltarViaCell!
		
		Text """
			You should probably look through the hole to see where it leads.
			Place a Sight token as indicated.
		"""
	End Page PlaceExploreAltarViaCell
	
	Page PlaceDavidsSon
		Visible When Not ritual
		
		Add TokenSearchCellMathiasSon!
		
		Text """
			A boy is chained to the wall, lying on the floor, and moaning
			quietly. Place a Person token as indicated. This is Mathias's son.
		"""
		
		If readAboutBoy Then Text """
			A boy is chained to the wall, lying on the floor, moaning
			quietly. Place a Person token as indicated. This is Mathias's son,
			the sacrifice.
		"""
	End Page PlaceDavidsSon
	
	Page PlaceEnd No Text
		Exit
	End Page PlaceEnd
	
	Page SearchBoy
		Text """
			The boy is mesmerized. He doesn’t respond to you, no matter what you
			do.
		"""
		Exit
	End Page SearchBoy
	
	Page PlaceCellHoleInWall
		Triggered by @PlaceExploreAltarViaCell When Not cellHoleFound
		
		Add TokenCellHoleInWall!
		
		Text """
			<i>A hole in the wall? That must be in the room where we found the
			boy,<i> you think.
			
			Place a Trapdoor as indicated.
		"""
		
		If ritual Then Text """
			<i>A hole in the wall? That must be in the cell you found earlier,
			<i> you think to yourself.
		"""
		
		cellHoleFound = true
		Exit
	End Page
End Book DungeonCell