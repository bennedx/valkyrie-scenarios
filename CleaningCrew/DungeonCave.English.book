Language English

Book DungeonCave Ordered No Keep Looped

	Page Explore
		Triggered By @ExploreDungeonCave
		
		Prolog """
			This door looks well-maintained, like it has been used recently.
		"""
		Button "Explore"
		
		Remove TokenExploreDungeonCaveViaBasement
		Add TileTortureChamber
		
		Text """
			When you open the door, you are surprised to see a cave hewn from
			the rock. Flickering torches make shadows slowly dance on the walls.
			
			Place the {c:TileTortureChamber} tile, then discard this Explore
			token.
		"""
		
		exploredDungeonCave = true
	End Page Explore
		
	
	Page PlaceExploreCrypt
		Add TokenExploreCryptViaDungeonCave!
		
		Text """
			The cave continues into the darkness. Place a Sight token as
			indicated.
		"""
	End Page PlaceExploreCrypt
	
	Page PlaceExploreTortureChamber
		Add TokenExploreTortureChamber!
		
		Text """
			To the right, a door leads... somewhere. That part of the cave
			seems more finished than the rest of the cave and feels much more
			substantial. Place an Explore token as indicated.
		"""
	
		Trigger @MoveAfterExplore
		Exit
	End Page PlaceExploreTortureChamber
End Book DungeonCave