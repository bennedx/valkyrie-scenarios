Language English
Debug Off

Book Startup Ordered No Keep Looped

	Page StartUp No Text
		Not Visible
		Triggered By @EventStart

		testMode = true
		
		roundsBeforeRitual = (5 - #heros) * 2 + 15
				
		//	wanderers are the cultists who keep coming through the chapel's
		//	secret passage. These variables manage their startup
		
		// these determine where the next wanderer appears
		// the farther into the house investigators have explored,
		// the farther back toward the study they appear.
		wandererInStudy = true
		wandererInLibrary = true
		wandererInChapel = true
		wandererInHall2 = true
		wandererInFoyer = true
		wandererInGallery = true

		// at most there can be only 6 cultists since that's all there
		// are in the box
		wandererCount = 0
		
		// This determines how often a wanderer appears. The fewer
		// investigators, the less often. A single player sees a new
		// one every 10 turns, while 5 will see one every 2 turns.
		wandererFrequency = (5 - #heros) * 2 + 2
		
		// this counts down to when the next one appears
		wandererCountdown = wandererFrequency
		
		// only one per
		wandererMax = #heros

		// wanderers killed so farther
		// wanderersKiled
		
		// ending flags
		endWin = 1
		endPartialWin = 2
		endFail = 3

		// set the goal for this run
		goalOpenGate = 1
		goalFeedGate = 2
		goalCloseGate = 3
		
		goal = goalCloseGate //RANDOM(3)
		
		If Not testMode Then Trigger @SplashScreen
		if Not testMode Then Exit
	End Page StartUp
	
	Page ShowEverything No Text
		Visible When testMode
		
		Add TileAltar
		Add TileBackyard
		Add TileBasement
		Add TileChapel
		Add	TileCrypt
		Add TileDiningRoom
		Add TileDriveway
		Add	TileFoyer
		Add	TileGallery
		Add	TileHall1
		Add TileHall2
		Add TileStudy
		Add TileTortureChamber
		
		
		Add TokenTestExploreAltar
		Add TokenTestExploreBackyardViaDriveway
		Add TokenTestExploreBasementViaDiningRoom
		Add TokenTestExploreBasementViaDiningRoomBlocked
		Add TokenTestExploreChapelViaLibrary
		Add TokenTestExploreCoatRoomViaGallery
		Add TokenTestExploreCryptViaChapel
		Add TokenTestExploreCryptViaDungeonCave
		Add TokenTestExploreDiningRoomViaBackyard
		Add TokenTestExploreDrivewayViaStartup
		Add TokenTestExploreDungeonCaveViaBasement
		Add TokenTestExploreDungeonCaveViaCrypt
		Add TokenTestExploreDungeonCellViaTortureChamber
		Add TokenTestExploreFoyerViaGallery
		Add TokenTestExploreFoyerViaHall2
		Add TokenTestExploreFoyerViaStudy
		Add TokenTestExploreGalleryViaHall1
		Add TokenTestExploreHall1ViaDiningRoom
		Add TokenTestExploreHall2ViaHall1
		Add TokenTestExploreKitchenViaDiningRoom
		Add TokenTestExploreLibraryAfterCultist
		Add TokenTestExploreLibraryViaStudy
		Add TokenTestExploreStudyViaFoyer
		Add TokenTestExploreStudyViaHall2
		Add TokenTestExploreTortureChamberViaDungeonCave
		
		Add TokenTestSearchFluxStabilizer
		Add TokenTestSearchLibraryBookcase
		Add TokenTestTalkToChapelPriest
		
		Add TokenTestTakeBooks
		Add TokenTestStartRitual
		Add TokenTestRitualPreparations
		Add TokenTestRitualFinished
		Add TokenTestInitChosenInvestigator
		Add TokenTestJournal2
		Add TokenBackyardBenBefore
		Add TokenBackyardBenPassive
		Add TokenDiningRoomBen
		
		Exit
	End Page ShowEverything
	
	Page SplashScreen No Text
		Not Visible
		Triggered By @SplashScreen
		
		Add UIStoryImage, UIStoryBackground, UIOpeningText, UIStoryFrame, UIOpeningTitle, UIStoryContinue
		Exit
	End Page SplashScreen
	
	Page SplashScreenClosed No Text
		Not Visible
		Triggered By @SplashScreenClosed
		Remove UIStoryImage, UIStoryBackground, UIOpeningText, UIStoryFrame, UIOpeningTitle, UIStoryContinue
	End Page SplashScreenClosed
	
	Page StartScenario
	    Not Visible When testMode
		Text "Each investigator receives 1 {clue}."
	End Page StartScenario
	
	Page Kate
		Visible When #HeroKateWinthrop And Not testMode
		
		Text """
			Kate is running late, so she is hurried and inattentive. She grabs
			her {c:QItemFluxStabilizer} and turns to put it away. She cries out
			as it slips from her fingers and drops heavily to the floor.
			It cracks open when it hits and releases blue smoke. <i>How can the
			universe be so cruel and unfair?!</i> Kate discards her
			{c:QItemFluxStabilizer}. She angrily ruminates on the loss. That
			seething anger will carry with her through the day:  Kate becomes
			Focused. She becomes Focused before any monster attacks her.
		"""
	End Page Kate
	
	Page PlaceDriveway No Text
		Not Visible When testMode
		Trigger @ExploreDrivewayViaStartup
	End Page PlaceDriveway
End Book Startup