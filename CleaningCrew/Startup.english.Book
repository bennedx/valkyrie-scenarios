Language English

Debug On

Book Startup Ordered No Keep

	Page StartUp No Text
		Triggered By @EventStart

		testMode = false
		
		roundsBeforeRitual = (5 - #heros) * 2 + 15
				
		//	wanderers are the cultists who keep coming through the chapel's
		//	secret passage. These variables manage their startup
		
		// these determine where the next wanderer appears
		// the farther into the house investigators have explored,
		// the farther back toward the study they appear.
		wandererInStudy = true
		wandererInLibrary = true
		wandererInChapel = true
		wandererInHall2 = true
		wandererInFoyer = true
		wandererInGallery = true

		// at most there can be only 6 cultists since that's all there
		// are in the box
		wandererCount = 0
		
		// This determines how often a wanderer appears. The fewer
		// investigators, the less often. A single player sees a new
		// one every 10 turns, while 5 will see one every 2 turns.
		wandererFrequency = (5 - #heros) * 2 + 2
		
		// this counts down to when the next one appears
		wandererCountdown = wandererFrequency
		
		// only one per
		wandererMax = #heros

		// wanderers killed so farther
		// wanderersKiled
		
		// ending flags
		endWin = 1
		endPartialWin = 2
		endFail = 3

		// set the goal for this run
		goalOpenGate = 1
		goalFeedGate = 2
		goalCloseGate = 3
		
		goal = RANDOM(3)
		
		If Not testMode Then Trigger @SplashScreen
		
		Exit
	End Page StartUp
	
	Page ShowEverything No Text
		Visible When testMode
		
		Add TokenTestPlaceDriveway, TokenTestTakeBooks, TokenTestStartRitual
		Add TokenTestRitualPreparations, TokenTestRitualFinished
		Add TokenTestPlaceTortureChamber, TokenTestPlaceLibraryViaStudy
		Add TokenTestPlaceLibraryAfterCultists, TokenTestPlaceChapelViaLibrary
		Add TokenTestPlaceKitchenViaDiningRoom, TokenTestPlaceStudyViaHall2
		Add TokenTestPlaceHall2ViaHall1, TokenTestPlaceStudyViaFoyer
		Add TokenTestPlaceDungeonCell, TokenTestPlaceCryptViaDungeonCave
		Add TokenTestPlaceDiningRoomViaBackdoor, TokenTestPlaceCryptViaChapel
		Add TokenTestPlaceCoatRoomViaGallery, TokenTestPlaceAltar
		Add TokenTestInitChosenInvestigator, TokenTestPlaceDriveway
		Add TokenTestBasementViaDiningRoomSight, TileStudy, TileHall2
		Add TileGallery, TileFoyer, TileDriveway, TileDiningRoom, TileCrypt,
		Add TileChapel, TileBasement, TileBackyard, TileAltar
		Add TokenTestPlaceHall1ViaDiningRoom, TokenTestPlaceFoyerViaGallery
		Add TokenTestPlaceGalleryViaFoyer, TokenExploreHall2ViaFoyer
		Add TokenTestPlaceFoyerViaHall2, TokenTestPlaceStudyViaFoyer
		Add TokenTestPlaceStudyViaHall2, TokenTestPlaceFoyerViaStudy
		Add TokenTestPlaceHall2ViaFoyer, TokenTestPlaceDungeonCaveViaBasement
		Add TokenTestPlaceDungeonCaveViaCrypt, TokenTestPlaceHall1ViaHall2
		Add TokenTestPlaceBackdoorViaDriveway, TokenTestPlaceGalleryViaHall1
		Add TokenTestJournal2, TokenTestBenTrigger, TileHall1
		Add TileTortureChamber, TokenBackyardBenBefore, TokenBackyardBenAfter
		Add TokenBackyardBenPassive, TokenTestBackdoorLocked
		
		Exit
	End Page ShowEverything
	
	Page SplashScreen No Text
		Not Visible
		Triggered By @SplashScreen
		
		Add UIStoryImage, UIStoryBackground, UIOpenText, UIStoryFrame, UIOpeningTitle, UIStoryContinue
	End Page SplashScreen
	
	Page SplashScreenClosed No Text
		Triggered By @SplashScreenClosed
		Remove UIStoryImage, UIStoryBackground, UIOpenText, UIStoryFrame, UIOpeningTitle, UIStoryContinue
	End Page SplashScreenClosed
	
	Page StartScenario No Text
		Not Visible When testMode
		
		Text "Each investigator receives 1 {clue}."
	End Page StartScenario
	
	Page Kate
		Visible WHEN #HeroKateWinthrop
		
		Text """
			Kate is running late, so she is hurried and inattentive. She grabs
			her {c:QItemFluxStabilizer} and turns to put it away. She cries out
			as it slips from her fingers and drops heavily to the floor.
			It cracks open when it hits and releases blue smoke. <i>How can the
			universe be so cruel and unfair?!</i> Kate discards her
			{c:QItemFluxStabilizer}. She fumes and ruminates on the loss. That
			seething anger will carry with her through the day:  Kate becomes
			Focused. She becomes Focused before any monster attacks her.
		"""
		
		Trigger @PlaceDriveWay
	End Page Kate
End Book Startup