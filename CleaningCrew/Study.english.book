LANGUAGE English

Book Study Ordered No Keep Looped
	Page ExploreStudyViaHall2 No Text
		Triggered By @ExploreStudyViaHall2
		
		exploredStudyViaHall2 = true
		exploredStudyViaFoyer = false
		Goto ExploreStudy
	End Page ExploreStudyViaHall2

	Page ExploreStudyViaFoyer No Text
		Triggered By @ExploreStudyViaFoyer
		
		exploredStudyViaHall2 = true
		exploredStudyViaFoyer = false	
		Goto ExploreStudy		
	End Page ExploreStudyViaFoyer

	Page ExploreStudy
		Prolog """
			A small plaque on the door reads <<Study.>>
		"""
		
		Text """
			The door opens smoothly, like it has been used recently. Behind it,
			you find a well-appointed study.

			Discard all Explore tokens leading to this room. Place the 
			{c:TileStudy} tile and a door as indicated.
		"""
	
		exploredStudy = true
	End Page ExploreStudy

	Page PlaceExploreHall2
		Page Is Visible When exploredHall2 != exploredFoyer
		
		Text """
			A door next to you leads farther into the house. Place an Explore
			token as indicated.
		"""
		
		If Not exploredHall2 Add TokenExploreHall2ViaStudy
		If Not exploredFoyer Add TokenExploreFoyerViaStudy
	End Page PlaceExploreHall2

	Page PlaceExploreLibrary
		Add TokenExploreLibraryViaStudy!

		Text """
			A door in the far corner has a small brass plaque that reads
			<<Library.>> Place an Explore token as indicated.
		"""
	End Page PlaceExploreLibrary
	
	Page PlaceHealingStone
		Add TokenStudyHealingStone!

		Text """
			A large oak desk sits in the middle of the room. A dead plant and a
			mess of papers covers it. Place a Search token as indicated.
		"""
	End Page PlaceHealingStone
	
	Page SearchHealingStone
		Triggered By @SearchStudyHealingStone
		
		Prolog """
			The desk is covered in loose papers, books, and what look like
			several ancient artifacts.
		"""
			
		Text """
			You find an ugly stone carving among the detritus on the desk.
			You aren't sure why, but you must have it. Gain the
			{c:QItemHealingStone} Unique Item, then discard this Search token.
		"""
		
		foundHealingStone = true
		EXIT
	End Page Study
End Book Study